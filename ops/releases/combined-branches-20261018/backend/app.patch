@@ -0,0 +1,50 @@
+<?php
+
+/**
+ * Backfill procurement InventoryItem bridges for existing Goods.
+ * Safe/idempotent: creates or updates by good_id/sku. No demo fake data.
+ */
+
+require __DIR__.'/../vendor/autoload.php';
+$app = require __DIR__.'/../bootstrap/app.php';
+$app->make(Kernel::class)->bootstrap();
+
+use Illuminate\Contracts\Console\Kernel;
+use Modules\Inventory\Models\Good;
+use Modules\Inventory\Models\InventoryItem;
+use Modules\Inventory\Support\InventoryTenantContext;
+
+$tenant = $argv[1] ?? 'lanouveil';
+
+InventoryTenantContext::run($tenant, function () use ($tenant) {
+    $goods = Good::query()->orderBy('id')->get();
+    echo "Tenant={$tenant} goods={$goods->count()}\n";
+
+    foreach ($goods as $good) {
+        $item = InventoryItem::query()->where('good_id', $good->id)->first()
+            ?: InventoryItem::query()->where('sku', $good->sku)->first();
+
+        $payload = [
+            'tenant_id' => $good->tenant_id,
+            'good_id' => $good->id,
+            'sku' => $good->sku,
+            'name' => $good->name,
+            'unit' => $good->uom ?: 'units',
+            'reorder_level' => (float) ($good->reorder_level ?? 0),
+            'cost_price' => (float) ($good->unit_cost ?? 0),
+            'selling_price' => (float) ($good->unit_cost ?? 0),
+            'is_active' => (bool) ($good->is_active ?? ($good->status === 'active')),
+            'current_stock' => (float) ($good->quantity_on_hand ?? 0),
+        ];
+
+        if ($item) {
+            $item->fill($payload)->save();
+            echo "updated item #{$item->id} <- {$good->sku}\n";
+        } else {
+            $item = InventoryItem::query()->create($payload);
+            echo "created item #{$item->id} <- {$good->sku}\n";
+        }
+    }
+});
+
+echo "DONE\n";
