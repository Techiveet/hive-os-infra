+    /** A routed task has a known page; a related guide must not displace it. */
+    public function pageForTool(array $tool, CopilotContext $context): ?array
+    {
+        if (empty($tool['target_url'])) {
+            return null;
+        }
+        $document = CopilotKnowledgeDocument::query()
+            ->visibleTo($context->permissions(), $context->isCentral() ? 'central' : 'tenant', $context->enabledModules())
+            ->where('kind', 'submodule')->where('href', $tool['target_url'])->first();
+        if ($document === null) {
+            return null;
+        }
+
+        return [
+            'doc_key' => $document->doc_key, 'kind' => $document->kind,
+            'module' => $document->module, 'submodule' => $document->submodule,
+            'title' => $document->title, 'summary' => $document->summary,
+            'body' => $document->body, 'href' => $document->href, 'score' => 100,
+        ];
+    }
+
+    /** Counts and lists come from the dashboard's catalog, not a hardcoded answer. */
+    public function moduleOverview(string $query): array
+    {
+        $catalog = app(ModuleRegistry::class)->catalog();
+        $count = $catalog->count();
+        $content = "**HIVE.OS Enterprise Platform Modules**\n\nHive has **{$count} registered modules**. "
+            .'Your subscription and permissions determine which ones you can use.';
+        if (! preg_match('/how many|count|ስንት/iu', $query)) {
+            $content .= "\n\n".$catalog->pluck('name')->sort()->map(fn ($name) => '- '.$name)->implode("\n");
+        }
+
+        return ['content' => $content, 'total_modules' => $count];
+    }
+
+    /** A definition needs the named module's purpose, not a high-ranking screen guide. */
+    public function moduleExplanation(string $query, ?CopilotContext $context = null): ?array
+    {
+        $question = Str::lower(trim($query, " \t\n\r\0\x0B?!."));
+        if (! preg_match('/^(?:please\s+)?(?:what (?:is|does)|how does|explain|describe)\s+(?:the\s+)?(.+)$/u', $question, $match)) {
+            return null;
+        }
+        $subject = preg_replace('/\s+(?:briefly|in simple terms)$/u', '', $match[1]);
+        $subject = preg_replace('/\s+(?:module(?:\s+(?:do|work))?|work|do)(?:\s+in\s+hive(?:\.os)?)?$/u', '', $subject);
+        $subject = preg_replace('/\s+module\b.*$/u', '', $subject);
+        $documents = CopilotKnowledgeDocument::query()->where('kind', 'module')->where('doc_key', 'like', 'module:%');
+        if ($context !== null) {
+            $documents->visibleTo($context->permissions(), $context->isCentral() ? 'central' : 'tenant', $context->enabledModules());
+        } else {
+            $documents->whereIn('audience', ['tenant', 'all']);
+        }
+        foreach ($documents->get() as $document) {
+            $names = [$document->title, Str::headline($document->module)];
+            $names[] = preg_replace('/\s+management$/iu', '', $document->title);
+            // Aliases help with an explicitly named module; a screen name alone
+            // (for example invoice matching) must retain its more specific guide.
+            if (preg_match('/\bmodule\b/u', $question)) {
+                $names = array_merge($names, $document->keywords ?? []);
+            }
+            if (! in_array($subject, array_map(fn ($name) => Str::lower(trim($name)), $names), true)) {
+                continue;
+            }
+
+            return [
+                'doc_key' => $document->doc_key, 'kind' => 'module',
+                'module' => $document->module, 'submodule' => null,
+                'title' => $document->title, 'summary' => $document->summary,
+                'body' => $document->body, 'href' => $document->href, 'score' => 100,
+            ];
+        }
+
+        return null;
+    }
+
     /**
      * The single best module match for a query, used to answer "how does X
      * work" and to scope navigation answers.
