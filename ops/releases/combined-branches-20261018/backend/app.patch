+    public function resolveCredentialPhotoPath(): ?string
+    {
+        $profilePhoto = trim((string) ($this->profile_photo_path ?? ''));
+        if ($profilePhoto !== '') {
+            return $profilePhoto;
+        }
+
+        $user = null;
+        if ($this->user_id) {
+            $user = User::query()->find($this->user_id);
+        }
+
+        if (! $user && filled($this->work_email)) {
+            $user = User::query()
+                ->whereRaw('LOWER(email) = ?', [strtolower(trim((string) $this->work_email))])
+                ->first();
+        }
+
+        if (! $user) {
+            return null;
+        }
+
+        $avatarUrl = trim((string) ($user->avatar_url ?? ''));
+        if ($avatarUrl !== '') {
+            return $avatarUrl;
+        }
+
+        $avatarPath = trim((string) ($user->avatar_path ?? ''));
+
+        return $avatarPath !== '' ? $avatarPath : null;
+    }
