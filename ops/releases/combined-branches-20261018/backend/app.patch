new file mode 100644
index 000000000..2beec6143
--- /dev/null
+++ b/Modules/SupportBot/app/Notifications/SupportInboxNotification.php
@@ -0,0 +1,31 @@
+<?php
+
+namespace Modules\SupportBot\Notifications;
+
+use Illuminate\Notifications\Messages\BroadcastMessage;
+use Illuminate\Notifications\Notification;
+
+class SupportInboxNotification extends Notification
+{
+    public function __construct(public readonly array $details) {}
+
+    public function via(object $notifiable): array
+    {
+        return ['broadcast'];
+    }
+
+    public function toArray(object $notifiable): array
+    {
+        return $this->details;
+    }
+
+    public function toBroadcast(object $notifiable): BroadcastMessage
+    {
+        return (new BroadcastMessage([
+            'id' => $this->id,
+            'type' => static::class,
+            'data' => $this->details,
+            'created_at' => now()->toISOString(),
+        ]))->onConnection('sync');
+    }
+}
