diff --git a/Modules/SupportBot/app/Services/SupportInboxNotifier.php b/Modules/SupportBot/app/Services/SupportInboxNotifier.php
new file mode 100644
index 000000000..4f8ee5da8
--- /dev/null
+++ b/Modules/SupportBot/app/Services/SupportInboxNotifier.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace Modules\SupportBot\Services;
+
+use Modules\Identity\Models\User;
+use Modules\SupportBot\Events\SupportBotMessageBroadcast;
+use Modules\SupportBot\Events\SupportConversationEscalated;
+use Modules\SupportBot\Models\SupportBotConversation;
+use Modules\SupportBot\Notifications\SupportInboxNotification;
+use Modules\SupportBot\Support\SupportBotTenantContext;
+use Modules\Tenancy\Models\Tenant;
+use Ramsey\Uuid\Uuid;
+
+/** Persist once, then broadcast to the same authorized staff as the inbox. */
+class SupportInboxNotifier
+{
+    public function message(SupportBotMessageBroadcast $event): void
+    {
+        if ($event->message->sender_type !== 'visitor' || ! $event->conversation->isWithAgent()) {
+            return;
+        }
+        $this->deliver($event->conversation, 'message:'.$event->message->id, false);
+    }
+
+    public function escalated(SupportConversationEscalated $event): void
+    {
+        $notice = SupportBotTenantContext::run((string) $event->conversation->tenant_id,
+            fn () => $event->conversation->messages()->where('sender_type', 'system')->reorder('id', 'desc')->value('id'));
+        $this->deliver($event->conversation, 'escalation:'.($notice ?? $event->conversation->updated_at?->format('U.u')), true);
+    }
+
+    private function deliver(SupportBotConversation $conversation, string $eventKey, bool $escalation): void
+    {
+        $tenantId = (string) ($conversation->tenant_id ?: 'central');
+        $details = [
+            'category' => 'support_chat',
+            'title' => $escalation ? 'A visitor is waiting for support' : 'New customer support message',
+            // Keep visitor text and contact details inside the permission-gated inbox.
+            'body' => $escalation ? 'Open the support inbox to help this visitor.' : 'A visitor has replied. Open the conversation to read it.',
+            'url' => '/dashboard/support-bot/'.$conversation->bot_id.'/inbox?conversation='.$conversation->id,
+            'bot_id' => $conversation->bot_id,
+            'conversation_id' => $conversation->id,
+            'tenant_id' => $tenantId,
+            'created_at' => now()->toISOString(),
+        ];
+        $send = function () use ($conversation, $tenantId, $eventKey, $details): void {
+            // User, roles and notifications must all use the conversation's database.
+            User::query()->with(['roles.permissions', 'permissions'])->where('is_active', true)->chunkById(100, function ($users) use ($conversation, $tenantId, $eventKey, $details): void {
+                foreach ($users as $user) {
+                    if (! $user->can('view_support_bots') && ! $user->can('manage_support_bots')) {
+                        continue;
+                    }
+                    $id = Uuid::uuid5(Uuid::NAMESPACE_URL, 'hive-support:'.$tenantId.':'.$conversation->id.':'.$eventKey.':'.$user->id)->toString();
+                    $stored = $user->notifications()->firstOrCreate(['id' => $id], [
+                        'type' => SupportInboxNotification::class,
+                        'data' => $details,
+                        'read_at' => null,
+                    ]);
+                    if ($stored->wasRecentlyCreated) {
+                        $notification = new SupportInboxNotification($details);
+                        $notification->id = $id;
+                        // The persisted bell item survives even when WebSockets are unavailable.
+                        rescue(fn () => $user->notifyNow($notification));
+                    }
+                }
+            });
+        };
+        $currentTenant = tenancy()->initialized ? (string) tenant('id') : 'central';
+        if ($currentTenant === $tenantId) {
+            $send();
+        } elseif ($tenantId === 'central') {
+            tenancy()->central($send);
+        } else {
+            // A missing workspace must never fall back to central administrators.
+            Tenant::find($tenantId)?->run($send);
+        }
+    }
+}
