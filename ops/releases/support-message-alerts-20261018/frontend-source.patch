diff --git a/hooks/use-message-sound.ts b/hooks/use-message-sound.ts
new file mode 100644
index 00000000..3e0b420f
--- /dev/null
+++ b/hooks/use-message-sound.ts
@@ -0,0 +1,41 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { playMessageSound, unlockMessageSound } from "@/lib/message-sound";
+
+export function useMessageSound(scope: string) {
+  const [enabled, setEnabled] = useState(true);
+  const enabledRef = useRef(true);
+  const storageKey = `hive-message-sound:${scope}`;
+  useEffect(() => {
+    const load = () => {
+      try {
+        enabledRef.current = localStorage.getItem(storageKey) !== "muted";
+        setEnabled(enabledRef.current);
+      } catch { /* A private browser can keep the preference in memory. */ }
+    };
+    load();
+    const unlock = (event: Event) => {
+      if (event.isTrusted && enabledRef.current) unlockMessageSound();
+    };
+    window.addEventListener("pointerdown", unlock, true);
+    window.addEventListener("keydown", unlock, true);
+    window.addEventListener("storage", load);
+    return () => {
+      window.removeEventListener("pointerdown", unlock, true);
+      window.removeEventListener("keydown", unlock, true);
+      window.removeEventListener("storage", load);
+    };
+  }, [storageKey]);
+  const toggle = () => {
+    const next = !enabledRef.current;
+    enabledRef.current = next;
+    setEnabled(next);
+    try { localStorage.setItem(storageKey, next ? "enabled" : "muted"); } catch { /* In-memory fallback. */ }
+    if (next) unlockMessageSound();
+  };
+  const play = useCallback((id: string) => {
+    if (enabledRef.current) playMessageSound(`${scope}:${id}`);
+  }, [scope]);
+  return { enabled, toggle, play };
+}
diff --git a/lib/message-sound.ts b/lib/message-sound.ts
new file mode 100644
index 00000000..ddb4287d
--- /dev/null
+++ b/lib/message-sound.ts
@@ -0,0 +1,39 @@
+/** One short chime per received message, shared by websocket and poll delivery. */
+let audio: AudioContext | null = null;
+let lastPlayed = 0;
+const seen = new Set<string>();
+
+export function unlockMessageSound(): void {
+  try {
+    audio ??= new AudioContext();
+    if (audio.state === "suspended") void audio.resume().catch(() => {});
+  } catch {
+    // Browsers without Web Audio still receive visual notifications.
+  }
+}
+
+export function playMessageSound(key: string): void {
+  if (seen.has(key)) return;
+  seen.add(key);
+  if (seen.size > 512) seen.delete(seen.values().next().value!);
+  if (!audio || audio.state !== "running" || Date.now() - lastPlayed < 800) return;
+  lastPlayed = Date.now();
+  try {
+    const start = audio.currentTime;
+    const oscillator = audio.createOscillator();
+    const volume = audio.createGain();
+    oscillator.type = "sine";
+    oscillator.frequency.setValueAtTime(740, start);
+    oscillator.frequency.setValueAtTime(988, start + 0.09);
+    volume.gain.setValueAtTime(0, start);
+    volume.gain.linearRampToValueAtTime(0.08, start + 0.015);
+    volume.gain.exponentialRampToValueAtTime(0.001, start + 0.24);
+    oscillator.connect(volume);
+    volume.connect(audio.destination);
+    oscillator.start(start);
+    oscillator.stop(start + 0.25);
+    oscillator.onended = () => { oscillator.disconnect(); volume.disconnect(); };
+  } catch {
+    // A suspended audio device must not interrupt chat delivery.
+  }
+}
