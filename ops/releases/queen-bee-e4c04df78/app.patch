+    /** Native options keep CPU inference within the deployment's allocation. */
+    protected function callOllama(
+        string $baseUrl,
+        ?string $apiKey,
+        string $model,
+        string $systemPrompt,
+        array $history,
+        string $userMessage,
+        float $temperature,
+        int $maxTokens,
+        int $timeout,
+    ): ?string {
+        $messages = [['role' => 'system', 'content' => $systemPrompt]];
+        foreach ($history as $message) {
+            $messages[] = [
+                'role' => ($message['sender_type'] ?? 'visitor') === 'visitor' ? 'user' : 'assistant',
+                'content' => (string) ($message['content'] ?? ''),
+            ];
+        }
+        $messages[] = ['role' => 'user', 'content' => $userMessage];
+        $endpoint = preg_replace('~/v1$~', '', rtrim($baseUrl, '/')).'/api/chat';
+
+        try {
+            $request = Http::timeout($timeout)->connectTimeout(5)
+                ->retry(2, 300, self::retryUnlessTimedOut(...), throw: false);
+            if ($apiKey) {
+                $request = $request->withToken($apiKey);
+            }
+            $response = $request->post($endpoint, [
+                'model' => $model,
+                'messages' => $messages,
+                'stream' => false,
+                ...(str_starts_with(strtolower($model), 'qwen3') ? ['think' => false] : []),
+                'options' => [
+                    'temperature' => $temperature,
+                    'num_predict' => $maxTokens,
+                    'num_thread' => max(1, min(16, (int) config('services.ollama.num_thread', 2))),
+                    'num_ctx' => max(512, min(32768, (int) config('services.ollama.num_ctx', 2048))),
+                ],
+            ]);
+            if ($response->successful()) {
+                $text = $response->json('message.content');
+                if (is_string($text) && trim($text) !== '') {
+                    return $text;
+                }
+                $this->lastError = 'Ollama returned no completion text.';
+            } else {
+                $this->lastError = $this->describeHttpError($response->json(), $response->status());
+            }
+        } catch (\Throwable $exception) {
+            $this->lastError = 'Could not reach the configured Ollama service: '.$exception->getMessage();
+            Log::warning('SupportBot Ollama call failed: '.$exception->getMessage());
+        }
+
+        return null;
+    }
