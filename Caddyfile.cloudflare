{
	# Admin API only on the container's loopback: any other container on the
	# Docker network could otherwise rewrite the proxy config.
	admin localhost:2019
	# Resolve the real visitor IP. Requests arriving from Cloudflare's edge
	# carry it in CF-Connecting-IP; from anywhere else the TCP peer is the
	# client, and a spoofed header is ignored. Ranges: https://www.cloudflare.com/ips/
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(security) {
	header {
		# Enable HSTS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Prevent MIME sniffing
		X-Content-Type-Options "nosniff"

		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# Content Security Policy (Next.js + Laravel).
		# Wildcards scoped to the platform root domain instead of "https://*" so an
		# injected script cannot load from / exfiltrate to an arbitrary host.
		# 'unsafe-eval' retained for Monaco editor + WASM tooling (pdfjs/ffmpeg/bg-removal);
		# migrate to nonce + 'wasm-unsafe-eval' once the frontend emits per-request nonces.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.{$ROOT_DOMAIN:gulfingot.com}; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.{$ROOT_DOMAIN:gulfingot.com} wss://*.{$ROOT_DOMAIN:gulfingot.com}; worker-src 'self' blob:; frame-src 'self' blob: https://www.google.com https://maps.google.com; upgrade-insecure-requests;"

		# Remove identifying headers
		-X-Powered-By
		-Server
	}
}

# Laravel reads the client IP from X-Forwarded-For (config/trustedproxy.php).
# Send it the IP resolved above instead of Caddy's default, which would name
# the Cloudflare edge when proxied.
(backend_upstream) {
	# Prometheus scrapes /metrics over the Docker network; it is not public.
	respond /metrics 404
	reverse_proxy backend:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}

{$ROOT_DOMAIN:gulfingot.com}, {$FRONTEND_DOMAIN:hive.gulfingot.com}, *.{$ROOT_DOMAIN:gulfingot.com} {
	import security
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	handle /api/* {
		import backend_upstream
	}

	handle /sanctum/* {
		import backend_upstream
	}

	handle /storage/* {
		import backend_upstream
	}

	handle /tenancy/assets/* {
		import backend_upstream
	}

	reverse_proxy frontend:3000
}

{$BACKEND_DOMAIN:hive-backend.gulfingot.com} {
	import security
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	@horizon path /horizon /horizon/*
	redir @horizon https://{$HORIZON_DOMAIN:hive-queue.gulfingot.com}{uri} 308

	# Keep WebSocket upgrades working on the API domain for older clients.
	handle_path /app/* {
		reverse_proxy hive-reverb:9000
	}

	handle {
		import backend_upstream
	}
}

{$REVERB_DOMAIN:hive-ws.gulfingot.com} {
	import security
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	reverse_proxy hive-reverb:9000
}

{$HORIZON_DOMAIN:hive-queue.gulfingot.com} {
	import security
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	redir / /horizon 308
	import backend_upstream
}

# Meilisearch and Grafana are intentionally NOT exposed publicly. The app reaches
# them over the private Docker network; for ops, use the 127.0.0.1-bound host ports
# from docker-compose.prod.yml via an SSH tunnel.
